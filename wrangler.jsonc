{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ethosconsulting",
  "account_id": "66637ae2208e4b22ea620cc90a2d9dad",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "ethosconsultingmz.co.mz",
      "custom_domain": true,
    },
  ],
  "vars": {
    "TURNSTILE_HOSTNAMES": "ethosconsultingmz.co.mz",
    "CONTACT_FROM_EMAIL": "Ethos Consulting <website@email.ethosconsultingmz.co.mz>",
    "CONTACT_TO_EMAIL": "contacto@ethosconsultingmz.co.mz",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
}
